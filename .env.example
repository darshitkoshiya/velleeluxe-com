# Copy this file to `.env.local` and fill in the values.
# Never commit `.env.local` to git.

# Firebase Client (public - safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server-only - NEVER expose)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the whole key on one line, keeping the \n sequences, wrapped in double quotes.
FIREBASE_ADMIN_PRIVATE_KEY=

# Google — Sheets + Drive
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full private key on one line, keeping \n sequences, in double quotes.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Primary discovery method: share a Drive folder with the service account.
# Every Google Sheet dropped into this folder is read automatically.
# Get the folder ID from its URL: drive.google.com/drive/folders/<ID>
GOOGLE_DRIVE_PRODUCTS_FOLDER_ID=

# New structure: each supplier has a subfolder under this folder.
# When set, GOOGLE_DRIVE_PRODUCTS_FOLDER_ID becomes a fallback only.
GOOGLE_DRIVE_SUPPLIERS_FOLDER_ID=

# Fallback: a single named spreadsheet (used only when the folder ID is not set).
# Tabs named Products, Products-1, Products-2 … are all read automatically.
GOOGLE_SHEETS_SPREADSHEET_ID=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Set in Razorpay Dashboard > Settings > Webhooks (URL: https://velleeluxe.com/api/webhooks/razorpay)
RAZORPAY_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@velleeluxe.com
# Where new-order and contact-form notifications are sent
ADMIN_NOTIFICATION_EMAIL=koshiyadarshit94@gmail.com

# App
NEXT_PUBLIC_APP_URL=https://velleeluxe.com

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hi! I need help with my order.

# Shipping partners
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
EKART_CLIENT_ID=
EKART_CLIENT_SECRET=
# Used for the checkout pincode check (fallback when Shiprocket isn't set or fails)
EKART_API_KEY=

# Admin transaction PIN (required to issue or adjust store credit)
ADMIN_TPIN=

# Gemini Vision — automatic photo check on damaged / wrong-item returns
GEMINI_API_KEY=
# Optional: override the model (default gemini-2.5-flash)
GEMINI_MODEL=

# Google Drive folders
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_IMAGES_FOLDER_ID=
GOOGLE_DRIVE_SHEETS_FOLDER_ID=
