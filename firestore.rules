rules_version = '2';

// Firestore security rules for Vellee Luxe.
// Publish these in Firebase Console > Firestore Database > Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // Orders are created and updated only by the server (Firebase Admin SDK,
    // which bypasses these rules). Signed-in customers may read their own orders.
    match /orders/{orderId} {
      allow read: if request.auth != null && resource.data.customerId == request.auth.uid;
      allow write: if false;
    }

    // Each customer can read all of their own data...
    match /users/{userId}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // ...and write their own profile (name, phone, bank details) and other personal data,
    // EXCEPT store credit, which only the server (admin resolving a return) may change.
    match /users/{userId}/{collectionId}/{docId} {
      allow write: if request.auth != null
        && request.auth.uid == userId
        && collectionId != 'storeCredit';
    }

    // Return requests are created and updated only by the server (API routes).
    match /returns/{returnId} {
      allow read, write: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
